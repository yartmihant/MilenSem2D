# Назначение материалов-заглушек и блоков

create material 1
modify material 1 name 'mat_1'
modify material 1 set property 'MODULUS' value 1e+10
modify material 1 set property 'POISSON' value 0.25
modify material 1 set property 'DENSITY' value 2000
